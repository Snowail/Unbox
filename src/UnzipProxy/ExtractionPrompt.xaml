<Window x:Class="UnzipProxy.ExtractionPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height" MaxHeight="340"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- 回收站警示弹窗 (D2) -->
                <StackPanel x:Name="ModalRecycleAlertPanel" Visibility="Collapsed">
                    <TextBlock Text="分卷压缩包会整组移入回收站；缺少内容校验的格式（如 TAR 等）可能会有风险。"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource TextForegroundBrush}"
                               Margin="0,0,0,16" />
                </StackPanel>

                <!-- 密码输入弹窗 -->
                <StackPanel x:Name="ModalPasswordPanel" Visibility="Collapsed">
                    <TextBlock Text="此压缩包受密码保护，请输入解压密码："
                               FontSize="12"
                               Foreground="{DynamicResource TextForegroundBrush}"
                               Margin="0,0,0,8" />
                    <PasswordBox x:Name="PasswordInputBox" Height="28" Margin="0,0,0,16" />
                </StackPanel>

                <!-- 非法字符重命名弹窗 (D6) -->
                <StackPanel x:Name="ModalInvalidCharsPanel" Visibility="Collapsed">
                    <TextBlock Text="压缩包内包含 Windows 不支持的非法字符或保留名称："
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource TextForegroundBrush}"
                               Margin="0,0,0,8" />
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource WindowBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6"
                            MaxHeight="80"
                            Margin="0,0,0,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="InvalidItemsListText" FontSize="11" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>

                    <RadioButton x:Name="RadioBatchRename" Content="批量重命名：将非法字符全部替换为 &quot;-&quot; (默认)" IsChecked="True" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource TextForegroundBrush}" />
                    <RadioButton x:Name="RadioSkipInvalid" Content="仅提取可表示的文件（跳过该项，源包将保留）" FontSize="12" Margin="0,0,0,12" Foreground="{DynamicResource TextForegroundBrush}" />
                    <CheckBox x:Name="RememberInvalidCharsCheck" Content="记住我的选择，以后不再询问" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,14" />
                </StackPanel>

                <!-- 文件名编码选择弹窗（编码不确定时） -->
                <StackPanel x:Name="ModalEncodingPanel" Visibility="Collapsed">
                    <TextBlock Text="压缩包内的文件名缺少可靠的编码声明，请选择能正确显示文件名的解码方式："
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource TextForegroundBrush}"
                               Margin="0,0,0,8" />
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource WindowBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8"
                            MaxHeight="150"
                            Margin="0,0,0,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="EncodingOptionsPanel" />
                        </ScrollViewer>
                    </Border>
                    <CheckBox x:Name="RememberEncodingCheck" Content="记住我的选择，以后遇到同类压缩包不再询问" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,14" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="CancelButton" Content="取消" IsCancel="True" Margin="0,0,8,0" Padding="14,5" />
            <Button x:Name="SubmitButton" Style="{DynamicResource FluentPrimaryButtonStyle}"
                    IsDefault="True" Click="OnSubmitClick" />
        </StackPanel>
    </Grid>
</Window>
