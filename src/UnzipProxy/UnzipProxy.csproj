<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Unbox</AssemblyName>
    <Product>Unbox</Product>
    <AssemblyTitle>Unbox</AssemblyTitle>
    <Company>Unbox</Company>
    <Description>Unbox - Windows 11 Native Extraction Agent</Description>
    <Version>1.4.0</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <InformationalVersion>1.4.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>$(MSBuildProjectDirectory)\obj\UnboxBrand.ico</ApplicationIcon>
    <FinishedWave>$(MSBuildProjectDirectory)\obj\Finished.wav</FinishedWave>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\archive-formats.json" LogicalName="Unbox.ArchiveFormats.json" />
    <EmbeddedResource Include="$(FinishedWave)" LogicalName="Unbox.Finished.wav" />
  </ItemGroup>

  <Target Name="GenerateBrandIcon" BeforeTargets="PrepareForBuild"
          Inputs="..\..\appicon\package-box.svg;..\..\appicon\package-box-24px.svg;..\..\scripts\make_app_icon.ps1"
          Outputs="$(ApplicationIcon)">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\make_app_icon.ps1&quot; -Output &quot;$(ApplicationIcon)&quot;" />
  </Target>

  <Target Name="GenerateFinishedSound" BeforeTargets="PrepareForBuild"
          Inputs="..\..\Finished.mp3;$(MSBuildProjectFullPath)" Outputs="$(FinishedWave)">
    <MakeDir Directories="$(MSBuildProjectDirectory)\obj" />
    <Exec Command="ffmpeg -nostdin -hide_banner -loglevel error -y -i &quot;$(MSBuildProjectDirectory)\..\..\Finished.mp3&quot; -c:a pcm_s16le -f wav &quot;$(FinishedWave).tmp&quot;" />
    <Move SourceFiles="$(FinishedWave).tmp" DestinationFiles="$(FinishedWave)" />
  </Target>

</Project>
